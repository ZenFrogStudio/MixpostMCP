{
    "name": "onemedialabs/mixpostmcp",
    "description": "MixpostMCP - self-hosted social media management software.",
    "keywords": [
        "social-media-management",
        "content-scheduling",
        "social-platform-integration",
        "calendar-scheduling",
        "self-hosted",
        "open-sourced",
        "mixpostmcp",
        "mcp",
        "model-context-protocol"
    ],
    "homepage": "https://github.com/onemedialabs/mixpostmcp",
    "license": "MIT",
    "authors": [
        {
            "name": "Dima Botezatu",
            "email": "dima@inovector.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/contracts": "^10.47|^11.0|^12.0",
        "inertiajs/inertia-laravel": "^1.0|^2.0",
        "inovector/twitteroauth": "^7.0",
        "intervention/image": "^2.7",
        "laravel/horizon": "^5.0",
        "php-ffmpeg/php-ffmpeg": "^1.0",
        "spatie/laravel-package-tools": "^1.14",
        "spatie/temporary-directory": "^2.1",
        "tightenco/ziggy": "^2.5"
    },
    "require-dev": {
        "laradumps/laradumps": "^4.0",
        "laravel/mcp": "^1.0@beta",
        "nunomaduro/collision": "^8.1",
        "orchestra/testbench": "^9.2|^10.0",
        "pestphp/pest": "^2.34|^3.0",
        "pestphp/pest-plugin-faker": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "suggest": {
        "laravel/mcp": "Required for the MixpostMCP server, which lets AI agents read your accounts and results, draft posts and schedule them (needs Laravel 12.41+)"
    },
    "autoload": {
        "psr-4": {
            "OneMediaLabs\\MixpostMcp\\": "src",
            "OneMediaLabs\\MixpostMcp\\Database\\Factories\\": "database/factories"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OneMediaLabs\\MixpostMcp\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OneMediaLabs\\MixpostMcp\\MixpostMcpServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
